# ─────────────────────────────────────────────────────────────
# RentHub Pakistan — environment variables
# Copy to .env (local) or add to Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
# Local (npm run db:local starts an embedded Postgres on port 5433):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rentals"
# Production (Neon / Supabase / Vercel Postgres). Use the *pooled* URL for serverless:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Only needed if you are NOT on Vercel and the host header can't be trusted:
# AUTH_URL="https://yourdomain.com"

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"      # production: https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_SITE_NAME="RentHub Pakistan"
# Admin WhatsApp number in wa.me format: country code + number, digits only.
NEXT_PUBLIC_ADMIN_WHATSAPP="923295780676"

# ── Seed: first admin (no public admin signup exists) ────────
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"   # min 10 chars
ADMIN_NAME="Site Admin"
ADMIN_PHONE="03000000000"
# "true" adds demo owners + 14 sample listings (development / demos only!)
SEED_SAMPLE_DATA="false"

# ── Media storage: Cloudinary ────────────────────────────────
# Required in production. If unset, development falls back to public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Rate limiting (recommended on Vercel) ────────────────────
# Upstash Redis REST. If unset, an in-memory limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (password reset) ───────────────────────────────────
# https://resend.com — without a key, reset links are only printed to the server console in development.
RESEND_API_KEY=""
EMAIL_FROM="RentHub Pakistan <no-reply@yourdomain.com>"
